<?xml version="1.0"?>
<robot name="mobo_bot" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

    <xacro:arg name="run_gz_sim" default="false"/>

    <xacro:arg name="base_type" default="2WD"/>
    <xacro:property name="MOBOBOT_BASE_TYPE" value="$(arg base_type)"/>

    
    <material name="orange">
        <color rgba="1 0.55 0 1"/>
    </material>

    <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
    </material>

    <material name="silver">
        <color rgba="0.6 0.6 0.6 1"/>
    </material>

    <material name="grey">
        <color rgba="0.25 0.25 0.25 1"/>
    </material>

    <material name="blue">
        <color rgba="0.2 0.2 1 1"/>
    </material>

    <material name="red">
        <color rgba="1 0.1 0.1 1"/>
    </material>


    <xacro:macro name="inertial_sphere" params="mass radius *origin">
        <inertial>
            <xacro:insert_block name="origin"/>
            <mass value="${mass}" />
            <inertia ixx="${(2/5) * mass * (radius*radius)}" ixy="0.0" ixz="0.0"
                    iyy="${(2/5) * mass * (radius*radius)}" iyz="0.0"
                    izz="${(2/5) * mass * (radius*radius)}" />
        </inertial>
    </xacro:macro>  

    <xacro:macro name="inertial_box" params="mass x y z *origin">
        <inertial>
            <xacro:insert_block name="origin"/>
            <mass value="${mass}" />
            <inertia ixx="${(1/12) * mass * (y*y+z*z)}" ixy="0.0" ixz="0.0"
                    iyy="${(1/12) * mass * (x*x+z*z)}" iyz="0.0"
                    izz="${(1/12) * mass * (x*x+y*y)}" />
        </inertial>
    </xacro:macro>

    <xacro:macro name="inertial_cylinder" params="mass length radius *origin">
        <inertial>
            <xacro:insert_block name="origin"/>
            <mass value="${mass}" />
            <inertia ixx="${(1/12) * mass * (3*radius*radius + length*length)}" ixy="0.0" ixz="0.0"
                    iyy="${(1/12) * mass * (3*radius*radius + length*length)}" iyz="0.0"
                    izz="${(1/2) * mass * (radius*radius)}" />
        </inertial>
    </xacro:macro>

    <xacro:include filename="$(find mobo_bot_description)/urdf/robot_gazebo_properties.xacro" />


    <!-- Conditional inclusion -->
    <xacro:if value="${MOBOBOT_BASE_TYPE == '2WD'}">
        <xacro:include filename="$(find mobo_bot_description)/urdf/2WD/robot.xacro" />

        <xacro:if value="$(arg run_gz_sim)">
            <xacro:include filename="$(find mobo_bot_description)/urdf/2WD/gazebo_control.xacro" />
        </xacro:if>
        <xacro:unless value="$(arg run_gz_sim)">
            <xacro:include filename="$(find mobo_bot_description)/urdf/2WD/ros2_control.xacro" />
        </xacro:unless>
    </xacro:if>

    <xacro:if value="${MOBOBOT_BASE_TYPE == '4WD'}">
        <xacro:include filename="$(find mobo_bot_description)/urdf/4WD/robot.xacro" />

        <xacro:if value="$(arg run_gz_sim)">
            <xacro:include filename="$(find mobo_bot_description)/urdf/4WD/gazebo_control.xacro" />
        </xacro:if>
        <xacro:unless value="$(arg run_gz_sim)">
            <xacro:include filename="$(find mobo_bot_description)/urdf/4WD/ros2_control.xacro" />
        </xacro:unless>
    </xacro:if>

    <xacro:if value="${MOBOBOT_BASE_TYPE == 'MEC'}">
        <xacro:include filename="$(find mobo_bot_description)/urdf/MEC/robot.xacro" />

        <xacro:if value="$(arg run_gz_sim)">
            <xacro:include filename="$(find mobo_bot_description)/urdf/MEC/gazebo_control.xacro" />
        </xacro:if>
        <xacro:unless value="$(arg run_gz_sim)">
            <xacro:include filename="$(find mobo_bot_description)/urdf/MEC/ros2_control.xacro" />
        </xacro:unless>
    </xacro:if>

    <xacro:if value="${MOBOBOT_BASE_TYPE == '22WD'}">
        <xacro:include filename="$(find mobo_bot_description)/urdf/22WD/robot.xacro" />

        <xacro:if value="$(arg run_gz_sim)">
            <xacro:include filename="$(find mobo_bot_description)/urdf/22WD/gazebo_control.xacro" />
        </xacro:if>
        <xacro:unless value="$(arg run_gz_sim)">
            <xacro:include filename="$(find mobo_bot_description)/urdf/22WD/ros2_control.xacro" />
        </xacro:unless>
    </xacro:if>
    
    
</robot>