<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <xacro:macro name="gz_material_orange">
    <material>
      <ambient>1.0 0.5 0.0 1.0</ambient>
      <diffuse>1.0 0.5 0.0 1.0</diffuse>
      <specular>0.1 0.1 0.1 1.0</specular>
      <emissive>0.0 0.0 0.0 1.0</emissive>
    </material>
  </xacro:macro>

  <xacro:macro name="gz_material_red">
    <material>
      <ambient>1.0 0.0 0.0 1.0</ambient>
      <diffuse>1.0 0.0 0.0 1.0</diffuse>
      <specular>0.1 0.1 0.1 1.0</specular>
      <emissive>0.0 0.0 0.0 1.0</emissive>
    </material>
  </xacro:macro>

  <xacro:macro name="gz_material_blue">
    <material>
      <ambient>0.0 0.0 1.0 1.0</ambient>
      <diffuse>0.0 0.0 1.0 1.0</diffuse>
      <specular>0.1 0.1 0.1 1.0</specular>
      <emissive>0.0 0.0 0.0 1.0</emissive>
    </material>
  </xacro:macro>

  <xacro:macro name="gz_material_black">
    <material>
      <ambient>0.1 0.1 0.1 1.0</ambient>
      <diffuse>0.1 0.1 0.1 1.0</diffuse>
      <specular>0.1 0.1 0.1 1.0</specular>
      <emissive>0.0 0.0 0.0 1.0</emissive>
    </material>
  </xacro:macro>

  <xacro:macro name="gz_material_silver">
    <material>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <diffuse>0.6 0.6 0.6 1.0</diffuse>
      <specular>0.1 0.1 0.1 1.0</specular>
      <emissive>0.0 0.0 0.0 1.0</emissive>
    </material>
  </xacro:macro>

  <xacro:macro name="gz_material_grey">
    <material>
      <ambient>0.25 0.25 0.25 1.0</ambient>
      <diffuse>0.25 0.25 0.25 1.0</diffuse>
      <specular>0.1 0.1 0.1 1.0</specular>
      <emissive>0.0 0.0 0.0 1.0</emissive>
    </material>
  </xacro:macro>



  <gazebo reference="chassis">
    <visual>
      <xacro:gz_material_orange/>
    </visual>
  </gazebo>

  <gazebo reference='front_left_wheel'>
    <visual>
      <xacro:gz_material_black/>
    </visual>
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.0</mu2>
            <fdir1 gz:expressed_in="base_link">1 -1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference='rear_left_wheel'>
    <visual>
      <xacro:gz_material_black/>
    </visual>
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.0</mu2>
            <fdir1 gz:expressed_in="base_link">1 1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference='front_right_wheel'>
    <visual>
      <xacro:gz_material_black/>
    </visual>
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.0</mu2>
            <fdir1 gz:expressed_in="base_link">1 1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>

  <gazebo reference='rear_right_wheel'>
    <visual>
      <xacro:gz_material_black/>
    </visual>
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>0.0</mu2>
            <fdir1 gz:expressed_in="base_link">1 -1 0</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>



  <gazebo>
    <plugin
      filename="gz-sim-mecanum-drive-system"
      name="gz::sim::systems::MecanumDrive">
      <!-- Topic for the command input -->
      <topic>cmd_vel</topic>

      <!-- Wheel joints -->
      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <back_left_joint>rear_left_wheel_joint</back_left_joint>
      <back_right_joint>rear_right_wheel_joint</back_right_joint>

      <!-- Wheel parameters -->
      <wheelbase>0.12</wheelbase>
      <wheel_separation>0.236</wheel_separation>
      <wheel_radius>0.033</wheel_radius>
    </plugin>

    <plugin name="gz::sim::systems::OdometryPublisher" filename="gz-sim-odometry-publisher-system">
      <odom_topic>odom</odom_topic>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <publish_tf>true</publish_tf>
      <tf_topic>tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <xyz_offset>0 0 0</xyz_offset>
      <rpy_offset>0 0 0</rpy_offset>
    </plugin>

    <plugin
        filename="gz-sim-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher">
        <topic>joint_states</topic>
        <joint_name>front_left_wheel_joint</joint_name>
        <joint_name>front_right_wheel_joint</joint_name>
        <joint_name>rear_left_wheel_joint</joint_name>
        <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
  
</robot>