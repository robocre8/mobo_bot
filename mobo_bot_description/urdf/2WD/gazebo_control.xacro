<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <gazebo reference="chassis">
    <visual>
      <xacro:gz_material_orange/>
    </visual>
  </gazebo>



  <gazebo reference="left_wheel">
    <visual>
      <xacro:gz_material_black/>
    </visual>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="left_rim">
    <visual>
      <xacro:gz_material_red/>
    </visual>
  </gazebo>



  <gazebo reference="right_wheel">
    <visual>
      <xacro:gz_material_black/>
    </visual>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <gazebo reference="right_rim">
    <visual>
      <xacro:gz_material_red/>
    </visual>
  </gazebo>



  <gazebo reference="castor_wheel">
    <visual>
      <xacro:gz_material_silver/>
    </visual>
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>


  <gazebo>
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <!-- Topic for the command input -->
      <topic>cmd_vel</topic>

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.207</wheel_separation>
      <wheel_radius>0.033</wheel_radius>
    </plugin>

    <plugin name="gz::sim::systems::OdometryPublisher" filename="gz-sim-odometry-publisher-system">
      <odom_topic>odom</odom_topic>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <publish_tf>true</publish_tf>
      <tf_topic>tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <xyz_offset>0 0 0</xyz_offset>
      <rpy_offset>0 0 0</rpy_offset>
    </plugin>

    <plugin
        filename="gz-sim-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher">
        <topic>joint_states</topic>
        <joint_name>left_wheel_joint</joint_name>
        <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
  
</robot>